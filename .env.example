# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC-SHA256 signing secret for Tujenge Hub auth tokens.
# Set a strong random string in Cloudflare Workers via: wrangler secret put SESSION_SECRET
SESSION_SECRET="dev-tujenge-session-secret-change-in-prod"

# ADMIN_EMAIL & ADMIN_PASSWORD: Group Chair / Admin sign-in credentials (replaces Firebase Google Auth).
# Override ADMIN_PASSWORD in Cloudflare Workers via: wrangler secret put ADMIN_PASSWORD
ADMIN_EMAIL="blessedkapuya@gmail.com"
ADMIN_PASSWORD="TujengeAdmin2026!"
